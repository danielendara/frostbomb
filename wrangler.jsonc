{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "frostbombsite",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-04-18",
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Worker runs first for every request; HTML CSP nonces are set in src/worker/index.ts.
    "run_worker_first": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
