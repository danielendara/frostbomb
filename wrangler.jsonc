{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "frostbombsite",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-04-18",
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Worker runs for documents and SPA routes (not hashed /assets, fonts, or listed root static files).
    "run_worker_first": ["/*", "!/assets/*", "!/fonts/*", "!/favicon.svg", "!/og-image.png", "!/fallback-flake.webp"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
