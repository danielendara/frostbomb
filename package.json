{
  "name": "frostbomb",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "pretest": "npm run test:unit",
    "test": "playwright test",
    "test:e2e:smoke": "FROSTBOMB_E2E=smoke playwright test --project=sequential-smoke",
    "test:e2e:full": "FROSTBOMB_E2E=full playwright test",
    "test:unit": "vitest run",
    "performance:inventory": "node scripts/generate-performance-inventory.mjs",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@tweakpane/core": "^2.0.5",
    "postprocessing": "^6.39.5",
    "simplex-noise": "^4.0.3",
    "three": "^0.186.0",
    "tweakpane": "^4.0.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.60.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/three": "^0.186.0",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.129.1"
  }
}
