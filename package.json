{
  "name": "frostbomb",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "verify": "bash scripts/verify.sh",
    "build": "tsc && vite build",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "pretest": "npm run test:unit",
    "test": "playwright test --project=sequential-smoke",
    "test:e2e:smoke": "playwright test --project=sequential-smoke",
    "test:e2e:full": "playwright test",
    "test:unit": "vitest run",
    "performance:inventory": "node scripts/generate-performance-inventory.mjs",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@tweakpane/core": "^2.0.5",
    "postprocessing": "^6.39.5",
    "simplex-noise": "^4.0.3",
    "three": "^0.186.1",
    "tweakpane": "^4.0.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "happy-dom": "^21.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.129.1"
  }
}
