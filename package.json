{
  "name": "frostbomb",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "prepare": "simple-git-hooks",
    "prepush": "npm run lint && npx tsc --noEmit && npm run typecheck:tests && npm run test:unit",
    "verify": "bash scripts/verify.sh",
    "build": "tsc && vite build",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "pretest": "npm run test:unit",
    "test": "playwright test --project=sequential-smoke",
    "test:e2e:smoke": "playwright test --project=sequential-smoke",
    "test:e2e:full": "playwright test",
    "lint": "eslint src",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "performance:inventory": "node scripts/generate-performance-inventory.mjs",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@tweakpane/core": "^2.0.5",
    "postprocessing": "^6.39.6",
    "simplex-noise": "^4.0.3",
    "three": "^0.187.0",
    "tweakpane": "^4.0.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "simple-git-hooks": "^2.14.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.0.5",
    "wrangler": "^4.129.1"
  },
  "simple-git-hooks": {
    "pre-push": "npm run prepush"
  }
}
